{
 "title": "TRIAD leg answer (small review path)",
 "description": "The shape of one leg's answer on the small review path, in the form the vendors' schema engines accept. It carries no binding member: the host attributes an answer to its leg from the place it was saved.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "verdict",
  "criteria_checked",
  "findings",
  "affected_surfaces_inspected",
  "open_questions"
 ],
 "properties": {
  "verdict": {
   "enum": [
    "SAFE TO MERGE",
    "MERGE WITH FIXES",
    "DO NOT MERGE"
   ]
  },
  "criteria_checked": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/nonblank"
   }
  },
  "findings": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/finding"
   }
  },
  "affected_surfaces_inspected": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/relativePath"
   }
  },
  "open_questions": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/nonblank"
   }
  }
 },
 "$defs": {
  "nonblank": {
   "type": "string",
   "pattern": "\\S"
  },
  "relativePath": {
   "type": "string",
   "pattern": "^(?:(?:[^./\\\\\\x00-\\x1f\\x7f][^/\\\\\\x00-\\x1f\\x7f]*|(?:\\.[^./\\\\\\x00-\\x1f\\x7f][^/\\\\\\x00-\\x1f\\x7f]*|\\.\\.[^/\\\\\\x00-\\x1f\\x7f]+))(?:/(?:[^./\\\\\\x00-\\x1f\\x7f][^/\\\\\\x00-\\x1f\\x7f]*|(?:\\.[^./\\\\\\x00-\\x1f\\x7f][^/\\\\\\x00-\\x1f\\x7f]*|\\.\\.[^/\\\\\\x00-\\x1f\\x7f]+)))+|[^./\\\\\\s\\x00-\\x1f\\x7f][^/\\\\\\x00-\\x1f\\x7f]*|[^\\S\\x00-\\x1f\\x7f]+[^/\\\\\\s\\x00-\\x1f\\x7f][^/\\\\\\x00-\\x1f\\x7f]*|(?:\\.[^./\\\\\\x00-\\x1f\\x7f][^/\\\\\\x00-\\x1f\\x7f]*|\\.\\.[^/\\\\\\x00-\\x1f\\x7f]+))$"
  },
  "finding": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "line",
    "severity",
    "summary",
    "trigger",
    "evidence",
    "context_known"
   ],
   "properties": {
    "path": {
     "$ref": "#/$defs/relativePath"
    },
    "line": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 1
      },
      {
       "type": "null"
      }
     ]
    },
    "severity": {
     "enum": [
      "Critical",
      "must-fix",
      "Minor",
      "HARDENING-SUGGESTION"
     ]
    },
    "summary": {
     "$ref": "#/$defs/nonblank"
    },
    "trigger": {
     "$ref": "#/$defs/nonblank"
    },
    "evidence": {
     "$ref": "#/$defs/nonblank"
    },
    "context_known": {
     "type": "boolean"
    }
   }
  }
 }
}
